<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BrowserSelector</AssemblyName>
    <RootNamespace>BrowserSelector</RootNamespace>
    <!-- Our own Main opens rule-matched links before WPF loads (App.xaml would generate one). -->
    <StartupObject>BrowserSelector.Program</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>

    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0-beta.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Browser Selector</Product>
    <AssemblyTitle>Browser Selector</AssemblyTitle>
    <Company>Mohammad Diab</Company>
    <Copyright>Copyright © 2024-2026 Mohammad Diab</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
