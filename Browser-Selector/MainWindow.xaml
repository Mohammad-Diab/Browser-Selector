<Window x:Class="Browser_Selector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Browser_Selector"
        mc:Ignorable="d"
        Title="Browser Selector" Height="150" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow">
    <StackPanel Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock TextWrapping="Wrap" Text="Browser Selector"/>
            <Button Grid.Column="1" Content="Settings" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Top"/>

        </Grid>
        <Grid>
            <TextBlock TextWrapping="Wrap" Text="URL"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="startupURl" TextWrapping="Wrap" Text="TextBox" Margin="0,0,10,0"/>
            <Button Content="Copy" Grid.Column="1" Click="CopyButton_Click"/>
        </Grid>
        <Grid>
            <TextBlock TextWrapping="Wrap" Text="Select a Browser to open"/>
        </Grid>
        <StackPanel Orientation="Horizontal">
        <Button Content="Edge"/>
        <Button Content="Firefox"/>
            <Button Content="Chrome"/>
        </StackPanel>

    </StackPanel>
</Window>
