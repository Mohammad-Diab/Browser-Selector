<Window x:Class="BrowserSelector.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BrowserSelector"
        Style="{StaticResource AppWindow}"
        Title="Browser Selector" Width="380"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="Manual" Background="{DynamicResource CardBg}">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel x:Name="Root">
            <!-- Link -->
            <Grid Margin="14,10,8,10" Background="Transparent" x:Name="TitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HostText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LinkText" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                               FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="{local:Tr Picker.Copy}" Click="Copy_Click" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{local:Tr Picker.Settings}" Click="Settings_Click" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{local:Tr Picker.Close}" Click="Close_Click" />
            </Grid>
            <Border Height="1" Background="{DynamicResource Line}" />

            <!-- Browsers -->
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Padding="6" MaxHeight="440"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Cycle">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Fg}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <EventSetter Event="MouseLeftButtonUp" Handler="Item_Click" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,7" Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Selected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:PickerItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="4" Background="{DynamicResource Badge}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Grid.Column="1" Source="{Binding Option.Browser.Icon}" Width="24" Height="24" Margin="10,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Option.Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                            <Border Grid.Column="3" x:Name="DefaultTag" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock Text="{local:Tr Picker.Default}" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter TargetName="DefaultTag" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoBrowsers" Text="{local:Tr Picker.NoBrowsers}" Style="{StaticResource MutedText}" Margin="16,14" Visibility="Collapsed" />

            <Border Height="1" Background="{DynamicResource Line}" />

            <!-- Options -->
            <StackPanel Margin="16,10,16,12">
                <CheckBox x:Name="PrivateBox" Content="{local:Tr Picker.Private}" Focusable="False" />
                <CheckBox x:Name="RememberBox" Margin="0,8,0,0" Focusable="False" />
                <TextBlock x:Name="HintText" Text="{local:Tr Picker.Hint}" FontSize="11" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
